+  orbit_field_update(sphy_v9r8_reg_zq_con3, SPHY_V9R8_ZQ_DS1_PDDS , 4);
+  orbit_field_update(sphy_v9r8_reg_zq_con3, SPHY_V9R8_ZQ_DS0_DDS  , 4);
+  orbit_field_update(sphy_v9r8_reg_zq_con3, SPHY_V9R8_ZQ_DS0_PDDS , 4);
